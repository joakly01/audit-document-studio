# api is the production default. demo must be explicitly selected.
VITE_DATA_MODE=api
VITE_API_BASE_URL=
# API_PROXY_TARGET=http://127.0.0.1:8000
# Host can hide standalone navigation via ?embed=1

# Optional subdirectory for static assets (default /).
# VITE_BASE_PATH=/document-studio/

# Confirm with the original service before enabling these relative API paths.
# VITE_MEETING_SUBMIT_URL=
# VITE_TIMELINE_SUBMIT_URL=
# VITE_BIDDING_SUBMIT_URL=
# VITE_MEETING_RISK_URL=
# VITE_MEETING_QUESTION_URL=

# POST { file_ids: [...] }; required for sources outside the current metadata cache.
# VITE_MATERIALS_URL=

# POST { task_uuid }; supports {id} in path. Must ONLY cancel, never delete history.
# Do not point this at DeleteTaskSchedules, whose behavior changes with task status.
# VITE_TASK_STOP_URL=

# Capability flag: configured value declares submit support for attachment_overrides.
# This is not called as a separate API. See docs/API-CONTRACT.md.
# VITE_TASK_ATTACHMENTS_URL=

# Only enable after the backend confirms billing_base_wan accepts yuan unchanged.
# VITE_PREPAID_UNIT_CONFIRMED=false
