{
  "name": "audit-document-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "test:browser": "node tests/browser-workspace.mjs && node tests/browser-library.mjs && node tests/browser-results.mjs && node tests/browser-smoke.mjs && node tests/browser-api-preview.mjs",
    "test:integration-review": "node tests/browser-integration-review.mjs && node tests/browser-task-boundaries.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "docx-preview": "^0.4.1",
    "element-plus": "^2.11.5",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.1"
  }
}
